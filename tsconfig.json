{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/ui/button": [
        "./registry/ui/button.tsx"
      ],
      "@/components/ui/input": [
        "./registry/ui/input.tsx"
      ],
      "@/components/ui/table": [
        "./registry/ui/table.tsx"
      ],
      "@registry/*": [
        "./registry/*"
      ],
      "@/components/ui/*": [
        "./registry/ui/*"
      ],
      "@/components/*": [
        "./registry/blocks/*"
      ],
      "@/hooks/*": [
        "./registry/hooks/*"
      ],
      "@/lib/utils": [
        "./registry/lib/utils.ts"
      ],
      "@docs/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}
