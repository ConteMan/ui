{
  "name": "conteman-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm registry:build && astro build && nimbus-docs lint && node scripts/check-artifacts.mjs",
    "registry:build": "node scripts/prepare-theme.mjs && shadcn build --output public/r",
    "check": "astro check",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "pnpm check && pnpm build",
    "deploy": "cf deploy dist"
  },
  "dependencies": {
    "@astrojs/react": "7.1.5",
    "@base-ui/react": "1.9.0",
    "@cloudflare/nimbus-docs": "0.19.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-table": "8.21.3",
    "astro": "7.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.29",
    "pagefind": "^1.5.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  }
}
